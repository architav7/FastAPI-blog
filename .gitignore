# Python-generated files
__pycache__/
*.py[oc]
*$py.class
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
venv/

# Local database files
*.db
*.db-*
*.sqlite
*.sqlite3

# User-uploaded media
/media/*
!/media/.gitkeep

# Local environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Logs and OS-generated files
*.log
.DS_Store
Thumbs.db
Desktop.ini
